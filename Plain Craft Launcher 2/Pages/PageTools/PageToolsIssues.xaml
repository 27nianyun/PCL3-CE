<local:MyPageRight x:Class="PCL.PageToolsIssues"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10" Grid.IsSharedSizeScope="True">

            <!-- 一、备份 -->
            <local:MyCard Margin="0,15" Title="备份">
                <StackPanel Margin="25,40,25,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="0" Grid.Row="0" VerticalAlignment="Center"
                                   Text="选择实例" Margin="0,0,20,0" />
                        <local:MyComboBox x:Name="ComboBackupInstance" Grid.Column="1" Grid.Row="0" Height="28" />

                        <TextBlock Grid.Column="0" Grid.Row="1" VerticalAlignment="Center"
                                   Text="备份地址" Margin="0,12,20,12" />
                        <local:MyTextBox x:Name="TextBackupRoot" Grid.Column="1" Grid.Row="1"
                                         Margin="0,12,10,12" HintText="留空则每次选择" />
                        <local:MyButton Grid.Column="2" Grid.Row="1" x:Name="BtnBackupBrowse" MinWidth="90"
                                        Text="选择" Margin="0,12,0,12" Click="BtnBackupBrowse_Click" />

                        <local:MyButton Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2"
                                        x:Name="BtnBackupStart" MinWidth="160" HorizontalAlignment="Left"
                                        Text="开始备份" ColorType="Highlight" Margin="0,8,0,0"
                                        Click="BtnBackupStart_Click" />
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <!-- 二、报错记录快捷查看与自动总结 -->
            <local:MyCard Margin="0,0,0,15" Title="报错记录（自动总结）">
                <StackPanel Margin="25,40,25,20">
                    <WrapPanel Margin="0,0,0,12">
                        <local:MyButton x:Name="BtnRefreshErrors" MinWidth="120" Text="刷新记录"
                                        Margin="0,0,12,0" Click="BtnRefreshErrors_Click" />
                        <local:MyButton x:Name="BtnOpenErrorFolder" MinWidth="140" Text="打开崩溃报告目录"
                                        Margin="0,0,12,0" Click="BtnOpenErrorFolder_Click" />
                    </WrapPanel>
                    <StackPanel x:Name="PanErrorList" />
                </StackPanel>
            </local:MyCard>

            <!-- 三、优化记录与撤销 -->
            <local:MyCard Margin="0,0,0,15" Title="优化记录与撤销">
                <StackPanel Margin="25,40,25,20">
                    <WrapPanel Margin="0,0,0,12">
                        <local:MyButton x:Name="BtnRefreshOpt" MinWidth="120" Text="刷新"
                                        Margin="0,0,12,0" Click="BtnRefreshOpt_Click" />
                        <local:MyButton x:Name="BtnClearOpt" MinWidth="120" Text="清空记录"
                                        Margin="0,0,12,0" ColorType="Red" Click="BtnClearOpt_Click" />
                    </WrapPanel>
                    <StackPanel x:Name="PanOptList" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
