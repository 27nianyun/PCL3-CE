<local:MyPageRight x:Class="PCL.PageToolsGuide"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10" Grid.IsSharedSizeScope="True">

            <!-- 攻略搜索 -->
            <local:MyCard Margin="0,15" Title="攻略搜索">
                <StackPanel Margin="25,40,25,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MySearchBox x:Name="PanSearchBox" SearchButtonVisibility="Visible"
                                           HintText="搜索整合包 / PvP / 生存 等攻略关键词" />
                        <local:MyButton Grid.Column="1" x:Name="BtnSearch" MinWidth="90" Text="搜索"
                                        Margin="10,0,0,0" ColorType="Highlight" Click="BtnSearch_Click" />
                    </Grid>
                    <StackPanel x:Name="PanGuideResults" Margin="0,16,0,0" />
                </StackPanel>
            </local:MyCard>

            <!-- 投影搜索与下载 -->
            <local:MyCard Margin="0,0,0,15" Title="投影搜索与下载">
                <StackPanel Margin="25,40,25,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MySearchBox x:Name="PanSchematicSearch" SearchButtonVisibility="Visible"
                                           HintText="搜索建筑 / 红石 / 投影 (litematic) 关键词" />
                        <local:MyButton Grid.Column="1" x:Name="BtnSearchSchematic" MinWidth="90" Text="搜索"
                                        Margin="10,0,0,0" ColorType="Highlight" Click="BtnSearchSchematic_Click" />
                    </Grid>
                    <StackPanel x:Name="PanSchematicResults" Margin="0,16,0,0" />
                </StackPanel>
            </local:MyCard>

            <!-- 快捷分类 -->
            <local:MyCard Margin="0,0,0,15" Title="快捷分类">
                <StackPanel Margin="25,40,25,20">
                    <WrapPanel>
                        <local:MyButton MinWidth="110" Text="整合包" Margin="0,0,12,10" Click="BtnCatPack_Click" />
                        <local:MyButton MinWidth="110" Text="PvP" Margin="0,0,12,10" Click="BtnCatPvp_Click" />
                        <local:MyButton MinWidth="110" Text="生存" Margin="0,0,12,10" Click="BtnCatSurvival_Click" />
                        <local:MyButton MinWidth="110" Text="红石" Margin="0,0,12,10" Click="BtnCatRedstone_Click" />
                        <local:MyButton MinWidth="110" Text="建筑" Margin="0,0,12,10" Click="BtnCatBuild_Click" />
                        <local:MyButton MinWidth="110" Text="指令" Margin="0,0,12,10" Click="BtnCatCommand_Click" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
