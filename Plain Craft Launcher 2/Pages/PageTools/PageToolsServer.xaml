<local:MyPageRight x:Class="PCL.PageToolsServer"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10" Grid.IsSharedSizeScope="True">

            <!-- 目标实例 -->
            <local:MyCard Margin="0,15" Title="一键配置服务器">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock Text="目标实例" Margin="0,0,0,6" />
                    <local:MyComboBox x:Name="ComboInstance" Height="28" />
                    <TextBlock Margin="0,12,0,6" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray3}"
                               Text="选择一个服务器，点击「加入」即可写入该实例的服务器列表（servers.dat），进入游戏后即可在多人游戏里看到。" />
                </StackPanel>
            </local:MyCard>

            <!-- 收录的服务器 -->
            <local:MyCard Margin="0,0,0,15" Title="收录服务器">
                <StackPanel Margin="25,40,25,20">
                    <StackPanel x:Name="PanFeaturedServers" />
                </StackPanel>
            </local:MyCard>

            <!-- 自定义服务器 -->
            <local:MyCard Margin="0,0,0,15" Title="自定义服务器">
                <StackPanel Margin="25,40,25,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" Text="名称" Margin="0,0,20,0" />
                        <local:MyTextBox x:Name="TextServerName" Grid.Column="1" Grid.Row="0" Height="28" HintText="服务器名称" />

                        <TextBlock Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" Text="地址" Margin="0,12,20,12" />
                        <local:MyTextBox x:Name="TextServerAddress" Grid.Column="1" Grid.Row="1" Height="28"
                                         Margin="0,12,0,12" HintText="例如 play.example.com 或 ip:port" />

                        <local:MyButton Grid.Column="1" Grid.Row="2" x:Name="BtnAddCustom" MinWidth="120"
                                        HorizontalAlignment="Left" Text="添加并保存" ColorType="Highlight"
                                        Margin="0,8,0,0" Click="BtnAddCustom_Click" />
                    </Grid>

                    <StackPanel x:Name="PanCustomServers" Margin="0,16,0,0" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
