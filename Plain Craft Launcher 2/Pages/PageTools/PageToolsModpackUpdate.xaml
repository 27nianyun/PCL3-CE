<local:MyPageRight x:Class="PCL.PageToolsModpackUpdate"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10" Grid.IsSharedSizeScope="True">

            <local:MyCard Margin="0,15" Title="整合包三方更新">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" FontSize="13"
                               Foreground="{DynamicResource ColorBrushGray3}"
                               Text="选择一个新版本的整合包压缩包，启动器会把它和实例里的文件逐一比对（按 SHA1），分成「新增 / 更新 / 移除 / 已一致」四类，先给你看清单再下载，不用整个整合包重装一遍。" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="目标实例" VerticalAlignment="Center" FontSize="13" Margin="0,0,10,0" />
                        <local:MyComboBox x:Name="ComboInstance" Grid.Column="1" Height="34" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="整合包" VerticalAlignment="Center" FontSize="13" Margin="0,0,10,0" />
                        <local:MyTextBox x:Name="TextPackPath" Grid.Column="1" IsReadOnly="True"
                                         ToolTip="选择新版本的整合包（.zip / .mrpack）" />
                        <local:MyButton x:Name="BtnPickPack" Grid.Column="2" MinWidth="110" Text="选择文件"
                                        Margin="10,0,0,0" Click="BtnPickPack_Click" />
                    </Grid>

                    <WrapPanel Margin="0,0,0,10">
                        <local:MyButton x:Name="BtnCompare" MinWidth="150" Text="对比差异" ColorType="Highlight"
                                        Margin="0,0,12,0" Click="BtnCompare_Click" />
                        <local:MyButton x:Name="BtnApply" MinWidth="150" Text="开始更新" IsEnabled="False"
                                        Margin="0,0,12,0" Click="BtnApply_Click" />
                        <local:MyCheckBox x:Name="CheckRemoveOld" Text="同时删除整合包已移除的文件"
                                          VerticalAlignment="Center" />
                    </WrapPanel>

                    <TextBlock x:Name="LabSummary" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,8"
                               Text="先选择实例和整合包，再点「对比差异」。" />

                    <StackPanel x:Name="PanChanges" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
