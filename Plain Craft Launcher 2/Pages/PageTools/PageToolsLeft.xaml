<local:MyPageLeft x:Class="PCL.PageToolsLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:PCL"
                  mc:Ignorable="d">
    <local:MyScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource ScrollViewerFullMargin}">
        <StackPanel Orientation="Vertical" x:Name="PanItem" Margin="0,12,0,0">

        <TextBlock Text="{DynamicResource Tools.Left.Utilities}" Margin="13,5,5,3" Opacity="0.6" FontSize="12"
                   x:Name="TextToolsCategory" />
        <local:MyListItem x:Name="ItemIssues"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="8"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="问题板块" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/triangle-alert" />
        <local:MyListItem x:Name="ItemResource"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="9"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="资源导入" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/folder-input" />
        <local:MyListItem x:Name="ItemWheel"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="15"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="转盘选择" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/gamepad-2" />
        <local:MyListItem x:Name="ItemModMatch"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="16"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="模组版本匹配" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/scan-search" />
        <local:MyListItem x:Name="ItemModpackUpdate"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="20"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="整合包更新" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/package-plus" />
        <local:MyListItem x:Name="ItemDependency"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="18"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="模组依赖图谱" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/git-pull-request-arrow" />
        <local:MyListItem x:Name="ItemSnapshot"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="17"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="环境还原点" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/rotate-ccw" />
        <local:MyListItem x:Name="ItemFavorites"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="19"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="资源收藏" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/heart-filled" />
        <local:MyListItem x:Name="ItemPreset"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="10"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="模组预设" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/book-marked" />
        <local:MyListItem x:Name="ItemRecommend"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="11"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="配置推荐" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/sparkles" />
        <local:MyListItem x:Name="ItemServer"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="12"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="服务器" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/server" />
        <local:MyListItem x:Name="ItemGuide"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="13"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="攻略" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/rocket" />
        <local:MyListItem x:Name="ItemLabs"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="14"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="实验室" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/flask-conical" />
        <local:MyListItem x:Name="ItemTest"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="3"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="{DynamicResource Tools.Left.Utilities.Title}" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/tool-case" />
        <local:MyListItem x:Name="ItemSkins"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="5"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="{DynamicResource Tools.Left.SkinLibrary.Title}" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/shirt" />
        <local:MyListItem x:Name="ItemSaves"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="4"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="{DynamicResource Tools.Left.Saves.Title}" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/earth" />
        <local:MyListItem x:Name="ItemSchematic"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="7"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="{DynamicResource Tools.Left.Schematic.Title}" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/box" />
        <local:MyListItem x:Name="ItemDeviceInfo"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="6"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="{DynamicResource Tools.Device.Title}" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/cpu" />

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageLeft>
