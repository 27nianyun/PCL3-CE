<local:MyPageRight x:Class="PCL.PageToolsResource"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10" Grid.IsSharedSizeScope="True">

            <!-- 拖拽投放区 -->
            <local:MyCard Margin="0,15" Title="拖拽导入（地图 / 光影包 / 数据包）">
                <StackPanel Margin="25,40,25,20">
                    <Border x:Name="PanDropZone" AllowDrop="True" DragOver="PanDropZone_DragOver" Drop="PanDropZone_Drop"
                            BorderBrush="{DynamicResource ColorBrushGray4}" BorderThickness="2" CornerRadius="8"
                            Background="{DynamicResource ColorBrushGray6}" Padding="20" MinHeight="120"
                            Cursor="Hand">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <local:MyIconTextButton x:Name="BtnPickFiles" HorizontalAlignment="Center" MinWidth="180"
                                                    Text="选择文件 / 文件夹" SvgIcon="lucide/upload"
                                                    Click="BtnPickFiles_Click" />
                            <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Text="将存档文件夹（含 level.dat）、光影包 zip、数据包 zip/文件夹拖到这里"
                                       Foreground="{DynamicResource ColorBrushGray3}" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Text="目标实例" Margin="0,0,0,6" />
                        <local:MyComboBox x:Name="ComboInstance" Height="28" />
                    </StackPanel>

                    <CheckBox x:Name="CheckOverwrite" Margin="0,14,0,0" IsChecked="True"
                              Content="导入时覆盖同名项" />

                    <StackPanel x:Name="PanImportHint" Margin="0,12,0,0" />
                </StackPanel>
            </local:MyCard>

            <!-- 已导入的光影包 -->
            <local:MyCard Margin="0,0,0,15" Title="光影包管理">
                <StackPanel Margin="25,40,25,20">
                    <WrapPanel Margin="0,0,0,12">
                        <local:MyButton x:Name="BtnRefreshShaders" MinWidth="120" Text="刷新"
                                        Margin="0,0,12,0" Click="BtnRefreshShaders_Click" />
                        <local:MyButton x:Name="BtnOpenShaderFolder" MinWidth="140" Text="打开光影目录"
                                        Margin="0,0,12,0" Click="BtnOpenShaderFolder_Click" />
                    </WrapPanel>
                    <StackPanel x:Name="PanShaderList" />
                </StackPanel>
            </local:MyCard>

            <!-- 已导入的数据包 -->
            <local:MyCard Margin="0,0,0,15" Title="数据包管理">
                <StackPanel Margin="25,40,25,20">
                    <WrapPanel Margin="0,0,0,12">
                        <local:MyButton x:Name="BtnRefreshDataPacks" MinWidth="120" Text="刷新"
                                        Margin="0,0,12,0" Click="BtnRefreshDataPacks_Click" />
                        <local:MyButton x:Name="BtnOpenDataPackFolder" MinWidth="140" Text="打开数据包目录"
                                        Margin="0,0,12,0" Click="BtnOpenDataPackFolder_Click" />
                    </WrapPanel>
                    <StackPanel x:Name="PanDataPackList" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
