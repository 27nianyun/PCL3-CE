<local:MyPageRight x:Class="PCL.PageToolsWheel"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10" Grid.IsSharedSizeScope="True">

            <local:MyCard Margin="0,15" Title="转盘选择游戏">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" FontSize="13"
                               Foreground="{DynamicResource ColorBrushGray3}"
                               Text="点击「转动转盘」，随机命中一个热门整合包 / 光影包 / 数据包，随后前往对应下载页获取。转动前可先「随机换一批」调整转盘上的项目。" />
                    <WrapPanel Margin="0,0,0,16">
                        <local:MyButton x:Name="BtnShuffle" MinWidth="150" Text="随机换一批"
                                        Margin="0,0,12,0" Click="BtnShuffle_Click" />
                        <local:MyButton x:Name="BtnSpin" MinWidth="150" Text="转动转盘"
                                        ColorType="Highlight" Click="BtnSpin_Click" />
                    </WrapPanel>

                    <!-- 转盘区域：Canvas 绘制扇形 + 指针 -->
                    <Grid HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Grid x:Name="PanWheelHost" Width="340" Height="340">
                            <Canvas x:Name="PanWheel" Width="340" Height="340" RenderTransformOrigin="0.5,0.5" />
                        </Grid>
                        <!-- 顶部指针（三角形） -->
                        <Path Fill="{DynamicResource ColorBrush3}" HorizontalAlignment="Center"
                              VerticalAlignment="Top" Margin="0,-4,0,0" Data="M 0,0 L 18,0 L 9,26 Z" />
                    </Grid>

                    <!-- 中心圆点 -->
                    <TextBlock x:Name="LabResult" HorizontalAlignment="Center" TextAlignment="Center"
                               FontSize="15" FontWeight="SemiBold" Margin="0,14,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="转盘上的项目">
                <StackPanel Margin="25,40,25,20">
                    <StackPanel x:Name="PanWheelItems" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
