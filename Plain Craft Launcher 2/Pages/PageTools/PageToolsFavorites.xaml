<local:MyPageRight x:Class="PCL.PageToolsFavorites"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:sys="clr-namespace:System;assembly=mscorlib"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10" Grid.IsSharedSizeScope="True">

            <local:MyCard Margin="0,15" Title="添加收藏">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" FontSize="13"
                               Foreground="{DynamicResource ColorBrushGray3}"
                               Text="把常用的模组、整合包、光影等在线项目记在这里，换实例或重装启动器后依然能找到。收藏会与本地实例比对，直接显示「已安装 / 未安装」。" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="名称" VerticalAlignment="Center" FontSize="13" Margin="0,0,10,0" />
                        <local:MyTextBox x:Name="TextFavName" Grid.Column="1" MaxLength="80" />
                        <TextBlock Text="类型" Grid.Column="2" VerticalAlignment="Center" FontSize="13"
                                   Margin="16,0,10,0" />
                        <local:MyComboBox x:Name="ComboFavType" Grid.Column="3" Height="32">
                            <local:MyComboBoxItem Content="模组" Tag="mod" />
                            <local:MyComboBoxItem Content="整合包" Tag="modpack" />
                            <local:MyComboBoxItem Content="光影" Tag="shader" />
                            <local:MyComboBoxItem Content="数据包" Tag="datapack" />
                            <local:MyComboBoxItem Content="资源包" Tag="resourcepack" />
                            <local:MyComboBoxItem Content="其他" Tag="other" />
                        </local:MyComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="链接" VerticalAlignment="Center" FontSize="13" Margin="0,0,10,0" />
                        <local:MyTextBox x:Name="TextFavUrl" Grid.Column="1" MaxLength="300" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="备注" VerticalAlignment="Center" FontSize="13" Margin="0,0,10,0" />
                        <local:MyTextBox x:Name="TextFavNote" Grid.Column="1" MaxLength="120" />
                    </Grid>

                    <WrapPanel>
                        <local:MyButton x:Name="BtnAddFavorite" MinWidth="140" Text="添加收藏"
                                        ColorType="Highlight" Margin="0,0,12,0" Click="BtnAddFavorite_Click" />
                        <local:MyButton x:Name="BtnImportMods" MinWidth="180" Text="从已安装模组批量收藏"
                                        Click="BtnImportMods_Click" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="我的收藏">
                <StackPanel Margin="25,40,25,20">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="比对实例" VerticalAlignment="Center" FontSize="13" Margin="0,0,10,0" />
                        <local:MyComboBox x:Name="ComboInstance" Grid.Column="1" Height="32" Margin="0,0,12,0"
                                          SelectionChanged="ComboInstance_SelectionChanged" />
                        <local:MyButton x:Name="BtnRefreshFavorites" Grid.Column="2" MinWidth="100" Text="刷新"
                                        Click="BtnRefreshFavorites_Click" />
                    </Grid>
                    <TextBlock x:Name="LabFavSummary" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <StackPanel x:Name="PanFavoriteList" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
